{
  "name": "construction",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@8.10.0",
  "scripts": {
    "install:all": "pnpm install",
    "dev:client": "pnpm --filter construction-client dev",
    "dev:server": "pnpm --filter construction-server dev",
    "build:client": "pnpm --filter construction-client build",
    "build:server": "pnpm --filter construction-server build",
    "build": "pnpm build:server && pnpm build:client",
    "start:client": "pnpm --filter construction-client start",
    "start:server": "pnpm --filter construction-server start"
  }
}
